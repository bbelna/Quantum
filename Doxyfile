#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

PROJECT_NAME           = "Quantum"
PROJECT_BRIEF          = "Object-Oriented Software For All"
PROJECT_NUMBER         = "0.1-alpha"

OUTPUT_DIRECTORY       = Build/Documentation
CREATE_SUBDIRS         = YES

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

# document source code
INPUT                  = ./
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.cpp *.inl *.inc *.ipp *.tpp *.S *.asm \
                         *.md

# ignore build artifacts and generated output
EXCLUDE_PATTERNS = */Build/* */.git/* */References/* */ThirdParty/* */LICENSE.md

#---------------------------------------------------------------------------
# Extraction / formatting
#---------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO

AUTOLINK_SUPPORT       = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
COLONCOLON_ARE_SCOPE = YES

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = HTML

HTML_EXTRA_STYLESHEET  = \
  ThirdParty/doxygen-awesome-css/doxygen-awesome.css \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css

HTML_EXTRA_FILES       = \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
  ThirdParty/doxygen-awesome-css/doxygen-awesome-interactive-toc.js

GENERATE_LATEX         = NO

USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
HIDE_SCOPE_NAMES       = YES

#---------------------------------------------------------------------------
# Aliases
#---------------------------------------------------------------------------

ALIASES += QApp="::Quantum::App"
